[Unit]
Description=server_base core stack (nginx + dnsmasq) via docker compose

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=@@REPO_ROOT@@

# systemd --user ユニットは system 側の docker.service に After/Requires
# できない(ユーザー manager の unit namespace に存在しないため)。
# dnsmasq-ubuntu-local.service (旧構成で唯一 systemd 経由の起動が実際に
# 機能していたユニット)もこの依存を宣言していなかった。実機で
# `Unit docker.service not found` により起動失敗することを確認して削除した。
#
# scripts/up.sh が core/compose.yaml と stacks/*/docker-compose.yml を
# まとめて展開し、nginx conf 生成 → up -d → nginx -t && reload まで行う
ExecStart=@@REPO_ROOT@@/scripts/up.sh
ExecStop=@@REPO_ROOT@@/scripts/down.sh

Restart=on-failure
RestartSec=10s

[Install]
WantedBy=default.target
