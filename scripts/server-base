#!/usr/bin/env python3
"""server-base CLI 実行エントリポイント。

TUI(`textual`)を使うため、`uv sync` で作られる `.venv` があればそちらの
python に re-exec する。`.venv` が無い場合はシステムの python3 でそのまま
動く(`cli` サブコマンドは標準ライブラリのみで動作するため)。
"""
import os
import sys
from pathlib import Path

_REPO_ROOT = Path(__file__).resolve().parent.parent
_VENV_DIR = _REPO_ROOT / ".venv"
_VENV_PYTHON = _VENV_DIR / "bin" / "python3"

# `.venv/bin/python3` はシステムの python (例: /usr/bin/python3.14) へのシンボリック
# リンクであることが多く、.resolve() で実体パスまで辿ると sys.executable の実体パスと
# 一致してしまい、システムの python3 で実行中でも「venv 内で実行中」と誤判定してしまう。
# venv 内かどうかは sys.prefix (site-packages の場所) で判定する。
if _VENV_PYTHON.is_file() and Path(sys.prefix).resolve() != _VENV_DIR.resolve():
    os.execv(str(_VENV_PYTHON), [str(_VENV_PYTHON), *sys.argv])

sys.path.insert(0, str(Path(__file__).resolve().parent))

from server_base_cli.main import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
